conn=pymysql.connect(host='127.0.0.1',port=3306,user='guest',password='123456',db='school',charset='utf8mb4',autocommit=True)
try:
    with conn.cursor() as cursor:
        affected_rows=cursor.execute('delete from `tb_college` where `col_id`=%s',(a,))
        if affected_rows==1:
            print('删除成功')
finally:
    conn.close()
