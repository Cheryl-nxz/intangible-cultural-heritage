import pymysql

a=input('输入学院编号')
b=input('学院名称')
c=input('学院的主要方向')

conn=pymysql.connect(host='127.0.0.1',port=3306,user='guest',password='123456',database='school',charset='utf8')

try:
    with conn.cursor() as cursor:
        affected_rows=cursor.execute(
            'insert into tb_college values (%s,%s,%s)',(a,b,c)
        )
        if affected_rows==1:
            print('新增学院成功')
        conn.commit()
except pymysql.MySQLError as e:
    conn.rollback()
    print(type(e),e)
finally:
    conn.close()
